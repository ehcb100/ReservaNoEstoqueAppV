// SOMENTE TESTE: qualquer pessoa pode criar uma conta anonima no projeto.
// NAO PUBLICAR EM PRODUCAO com dados reais de clientes.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /comandas/{id} {
      allow read, create, update, delete: if request.auth != null;
    }
    match /pushTokens/{id} {
      allow read, delete: if false;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['token','uid','updatedAt','platform'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() < 4096
        && request.resource.data.platform is string;
    }
    match /pushClaims/{id} { allow read, write: if false; }
  }
}

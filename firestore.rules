rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Substitua INSIRA_UID_DA_EQUIPE pelo UID da conta criada no Firebase Authentication.
    function equipe() {
      return request.auth != null && request.auth.uid == 'INSIRA_UID_DA_EQUIPE';
    }
    match /comandas/{id} {
      allow read, create, update, delete: if equipe();
    }
    match /pushTokens/{id} {
      allow read, delete: if false;
      allow create, update: if equipe()
        && request.resource.data.keys().hasOnly(['token','uid','updatedAt','platform'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() < 4096
        && request.resource.data.platform is string;
    }
    match /pushClaims/{id} { allow read, write: if false; }
  }
}

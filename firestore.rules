rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Exemplo de proteção de dispositivos. Mescle estas regras às regras EXISTENTES
    // das comandas no Console; NÃO substitua as regras inteiras por este arquivo.
    match /pushTokens/{id} {
      allow read, delete: if false;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['token','uid','updatedAt','platform'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() < 4096
        && request.resource.data.platform is string;
    }
    match /pushClaims/{id} { allow read, write: if false; }
  }
}
